{
  "name": "spectre-mail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SpectreMail - temporary email for the web and the browser. Monorepo root.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "pnpm --filter @spectre-mail/web build && pnpm --filter @spectre-mail/extension build",
    "build:web": "pnpm --filter @spectre-mail/web build",
    "build:extension": "pnpm --filter @spectre-mail/extension build",
    "dev:web": "pnpm --filter @spectre-mail/web dev",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "pnpm build && pnpm --filter @spectre-mail/extension build:fixture && pnpm --filter @spectre-mail/web test:browser && pnpm --filter @spectre-mail/extension test:browser",
    "spike:selftest": "pnpm --dir tests/provider-spike spike:selftest",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
