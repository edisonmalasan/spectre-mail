# Provider spike sender configuration.
#
# Copy to `.env` only if you want the spike to send a real test message.
# `.env` is gitignored. Credentials are read from the environment only and are
# never written to disk or included in the run artifact.
#
# Option A — SMTP (STARTTLS on 587, or implicit TLS on 465).
# SPECTRE_SPIKE_SMTP_HOST=smtp.example.com
# SPECTRE_SPIKE_SMTP_PORT=587
# SPECTRE_SPIKE_SMTP_SECURE=false
# SPECTRE_SPIKE_SMTP_USER=you@example.com
# SPECTRE_SPIKE_SMTP_PASS=your-app-password
#
# Option B — HTTP mail-send endpoint.
# The spike POSTs JSON `{ to, subject, text }` with a bearer token.
# SPECTRE_SPIKE_SEND_URL=https://api.example.com/v1/mail/send
# SPECTRE_SPIKE_SEND_TOKEN=your-token
#
# Overrides the From address used for the test message.
# SPECTRE_SPIKE_MAIL_FROM=SpectreMail Spike <you@example.com>
#
# Interactive mode timeout in milliseconds (default 300000 = 5 minutes).
# SPECTRE_SPIKE_INTERACTIVE_TIMEOUT_MS=300000
